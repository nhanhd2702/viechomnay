# ==============================================================================
# Việc Hôm Nay - Production Web Dockerfile (Multi-stage build)
# ==============================================================================

# Stage 1: Build Angular PWA
FROM node:22-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git python3 make g++

# Copy package files
COPY package*.json ./
COPY packages/ ./packages/
COPY tsconfig*.json ./
COPY tools/ ./tools/

# Install dependencies and build shared packages
RUN npm ci --ignore-scripts || npm install --legacy-peer-deps --ignore-scripts
RUN npm run prepare

# Copy source code and build webapp
COPY . .
ENV NODE_OPTIONS="--max-old-space-size=2048"
RUN npm run buildFrontend:prodWeb

# Stage 2: Minimal Nginx Alpine Server
FROM nginx:alpine

# Copy built application
COPY --from=builder /app/dist/browser /usr/share/nginx/html

# Copy Nginx SPA configuration
COPY nginx/nginx-spa.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
